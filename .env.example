OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MONTHLY_CREDIT_LIMIT_USD=5.00
OPENAI_CREDIT_BALANCE_USD=4.40

# 管理者画面（job-flask-app-service の利用者を管理）
SECRET_KEY=replace_with_a_long_random_value
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=replace_with_a_strong_password
# job-flask-app-service と同じPostgreSQLの接続文字列
SERVICE_DATABASE_URL=postgresql_database_url_for_job_flask_app_service

# Use one of these for Render. GOOGLE_CREDENTIALS_BASE64 is usually easier.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_CREDENTIALS_BASE64=base64_encoded_credentials_json

# Optional one-time data import for Render.
APP_DATA_IMPORT_BASE64=base64_encoded_exported_app_data
APP_DATA_IMPORT_REPLACE=0

# Recommended for persistent Render data.
DATABASE_URL=postgresql_database_url

# Optional. Render sets PORT automatically.
FLASK_DEBUG=0
